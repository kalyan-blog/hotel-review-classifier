# Database connection string
# Local development: sqlite:///./hotel_reviews.db
# Production (Render/PostgreSQL): postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./hotel_reviews.db

# Allowed frontend origin(s) for CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# Path to trained model artifact (optional, defaults to app/ml/models/hotel_review_classifier.joblib)
MODEL_PATH=app/ml/models/hotel_review_classifier.joblib
